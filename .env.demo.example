APP_ENV=demo
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=demo_postgres_password
POSTGRES_ADMIN_DB=postgres

COMPANY_A_DB_NAME=parknexus_company_a
COMPANY_A_DB_USER=company_a_user
COMPANY_A_DB_PASSWORD=demo_company_a_password
COMPANY_B_DB_NAME=parknexus_company_b
COMPANY_B_DB_USER=company_b_user
COMPANY_B_DB_PASSWORD=demo_company_b_password

PLATFORM_DB_NAME=parknexus_platform
PLATFORM_DB_USER=parknexus_platform_user
PLATFORM_DB_PASSWORD=demo_platform_password

A2A_SHARED_SECRET=demo_shared_hmac_secret_change_me
HOST_AGENT_ID=host_agent
HOST_AGENT_TOKEN=demo_host_token_change_me
REGISTRY_AGENT_ID=registry_agent
REGISTRY_AGENT_TOKEN=demo_registry_token_change_me
PROVIDER_AGENT_TOKEN=demo_provider_token_change_me
A2A_MAX_CLOCK_SKEW_SECONDS=300

HOST_AGENT_BASE_URL=https://localhost:8030
REGISTRY_AGENT_BASE_URL=https://localhost:8020
REGISTRY_AGENT_NAME=parknexus_registry_agent
REGISTRY_AGENT_VERSION=1.0.0
LOCAL_TLS_VERIFY=false

PARKNEXUS_ADMIN_USER=admin
PARKNEXUS_ADMIN_PASSWORD=admin123

HOST_INTENT_MODEL=gpt-4.1-mini

LOG_DIR=/app/logs
LOG_LEVEL=INFO
