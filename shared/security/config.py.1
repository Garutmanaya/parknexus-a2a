"""
Security configuration loader.

All secrets are loaded from environment variables.
No credentials should be hardcoded.
"""

import os

from dotenv import load_dotenv


def required_env(name: str) -> str:
    """
    Read required environment variable.
    """
    load_dotenv()
    value = os.getenv(name)

    if not value:
        raise RuntimeError(f"Missing required environment variable: {name}")

    return value


def optional_int_env(name: str, default: int) -> int:
    """
    Read optional integer environment variable.
    """
    load_dotenv()
    value = os.getenv(name)

    if not value:
        return default

    return int(value)


def get_a2a_shared_secret() -> str:
    """
    Shared HMAC secret for local A2A signing.
    """
    return required_env("A2A_SHARED_SECRET")


def get_allowed_agent_tokens() -> dict[str, str]:
    """
    Return trusted agent_id -> bearer token mapping.
    """
    return {
        required_env("HOST_AGENT_ID"): required_env("HOST_AGENT_TOKEN"),
        required_env("REGISTRY_AGENT_ID"): required_env("REGISTRY_AGENT_TOKEN"),
    }


def get_provider_token() -> str:
    """
    Token used by provider agents when acting as callers later.
    """
    return required_env("PROVIDER_AGENT_TOKEN")


def get_max_clock_skew_seconds() -> int:
    """
    Maximum allowed request timestamp skew.
    """
    return optional_int_env("A2A_MAX_CLOCK_SKEW_SECONDS", 300)


if __name__ == "__main__":
    print("Security config loaded successfully")
    print("A2A_SHARED_SECRET=********")
    print(f"Allowed agents: {list(get_allowed_agent_tokens().keys())}")
    print(f"Max clock skew: {get_max_clock_skew_seconds()} seconds")
