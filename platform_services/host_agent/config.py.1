"""
Configuration loader for ParkNexus Host Agent.
"""

import os

from dotenv import load_dotenv


def required_env(name: str) -> str:
    """
    Read required environment variable.
    """
    load_dotenv()
    value = os.getenv(name)

    if not value:
        raise RuntimeError(f"Missing required environment variable: {name}")

    return value


def bool_env(name: str, default: bool = False) -> bool:
    """
    Read boolean environment variable.
    """
    load_dotenv()
    value = os.getenv(name)

    if value is None:
        return default

    return value.lower() in {"true", "1", "yes", "y"}


def get_registry_agent_base_url() -> str:
    """
    Registry Agent base URL.
    """
    return required_env("REGISTRY_AGENT_BASE_URL").rstrip("/")


def get_httpx_verify_tls() -> bool:
    """
    Whether httpx should verify TLS certs.

    Local self-signed cert:
        false

    Cloud valid cert:
        true
    """
    return bool_env("LOCAL_TLS_VERIFY", False)


if __name__ == "__main__":
    print("Host Agent config loaded successfully")
    print(f"REGISTRY_AGENT_BASE_URL={get_registry_agent_base_url()}")
    print(f"HTTPX_VERIFY_TLS={get_httpx_verify_tls()}")
