"""
Natural language intent parsing for ParkNexus Host Agent.

This is the first AI-facing layer.

Current version:
    deterministic parser for local reliability

Later:
    replace parse_user_request() internals with LLM structured output
    while keeping ParkingIntent schema unchanged.
"""

import re
from decimal import Decimal

from pydantic import BaseModel


class ParkingIntent(BaseModel):
    """
    Structured parking search intent extracted from user text.
    """

    intent: str = "search_parking"
    level_name: str | None = None
    slot_type: str | None = None
    ev_charger: bool | None = None
    handicap: bool | None = None
    max_price_per_hour: Decimal | None = None
    sort_by: list[str] = ["price", "distance"]
    limit_per_provider: int = 5
    wants_reservation: bool = False


def extract_price_limit(text: str) -> Decimal | None:
    """
    Extract price limit from text.

    Examples:
        under $15
        below 10
        max 12 dollars
    """
    patterns = [
        r"under\s+\$?(\d+)",
        r"below\s+\$?(\d+)",
        r"less than\s+\$?(\d+)",
        r"max\s+\$?(\d+)",
        r"maximum\s+\$?(\d+)",
    ]

    for pattern in patterns:
        match = re.search(pattern, text)

        if match:
            return Decimal(match.group(1))

    return None


def parse_user_request(user_text: str) -> ParkingIntent:
    """
    Convert natural language user request into structured intent.
    """
    text = user_text.lower()

    level_name = None
    if "ground" in text or "ground level" in text:
        level_name = "GROUND"
    elif "rooftop" in text or "roof" in text:
        level_name = "ROOFTOP"
    elif "basement" in text:
        level_name = "BASEMENT_1"

    ev_charger = None
    if "ev" in text or "charger" in text or "charging" in text:
        ev_charger = True

    handicap = None
    if "handicap" in text or "accessible" in text or "ada" in text:
        handicap = True

    sort_by = ["price", "distance"]
    if "closest" in text or "near entrance" in text or "close to entrance" in text:
        sort_by = ["distance", "price"]
    elif "cheapest" in text or "lowest price" in text or "cheap" in text:
        sort_by = ["price", "distance"]

    wants_reservation = any(
        phrase in text
        for phrase in [
            "reserve",
            "book",
            "hold",
            "save me",
        ]
    )

    return ParkingIntent(
        level_name=level_name,
        ev_charger=ev_charger,
        handicap=handicap,
        max_price_per_hour=extract_price_limit(text),
        sort_by=sort_by,
        wants_reservation=wants_reservation,
    )


if __name__ == "__main__":
    """
    Manual test:
        python -m platform_services.host_agent.intent
    """
    samples = [
        "Find me a cheap ground level EV parking slot under $15",
        "I need accessible parking close to entrance",
        "Book me rooftop parking",
    ]

    for sample in samples:
        print(sample)
        print(parse_user_request(sample).model_dump())
        print()
